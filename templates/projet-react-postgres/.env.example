# Copie ce fichier en `.env` SUR LE VPS et remplis-le. Ne committe jamais `.env`.
# Génère un mot de passe solide :  openssl rand -base64 24

# --- Base de données PostgreSQL ---
POSTGRES_USER=projet1
POSTGRES_PASSWORD=change-moi-avec-un-mot-de-passe-fort
POSTGRES_DB=projet1

# URL de connexion utilisée par l'app.
# L'hôte est "postgres" = le nom du service dans docker-compose.yml (réseau interne).
DATABASE_URL=postgresql://projet1:change-moi-avec-un-mot-de-passe-fort@postgres:5432/projet1

# --- Application ---
# Domaine public servi par Traefik (informatif / pour CORS, liens absolus, etc.)
APP_URL=https://projet1.mondomaine.com
NODE_ENV=production
